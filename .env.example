# Copy to .env (and keep .env out of git)
STOAT_TOKEN=
BOT_PREFIX=!

# Postgres (used by docker-compose.yml)
POSTGRES_USER=pounce
POSTGRES_PASSWORD=change-me
POSTGRES_DB=pounce
POSTGRES_PORT=5432

# Must match the values above. URL-encode special characters in the password (e.g. @ -> %40).
DATABASE_URL=postgres://pounce:change-me@localhost:5432/pounce
